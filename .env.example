# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# App
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://your-domain.com

# Optional server-side key. Leave empty unless you add admin-only server code.
SUPABASE_SERVICE_ROLE_KEY=

# Required by the current app config. Generate a secure value before production.
ENCRYPTION_KEY=replace-with-a-secure-32-byte-base64-value

# Secret expected by /api/inbound/meal-plan-email via x-inbound-secret or Bearer token.
INBOUND_EMAIL_SECRET=replace-with-a-long-random-secret
